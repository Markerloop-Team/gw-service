# gw-service (API gateway) — example configuration. Placeholders only.

PORT=8080
HOST=0.0.0.0
READ_TIMEOUT=30s
WRITE_TIMEOUT=30s
IDLE_TIMEOUT=60s
PROXY_TIMEOUT=30s
LOG_LEVEL=info

# Upstreams
AUTH_SERVICE_URL=http://localhost:8081
USER_SERVICE_URL=http://localhost:8082
NOTIFICATION_SERVICE_URL=http://localhost:8083
DICTIONARY_SERVICE_URL=http://localhost:8084
TELEGRAM_BOT_SERVICE_URL=http://localhost:8085
COLLECTIONS_SERVICE_URL=http://localhost:8087
FILES_SERVICE_URL=http://localhost:8088
PAGES_SERVICE_URL=http://localhost:8089

# RS256 public key (PEM) used to verify access tokens. The gateway never signs.
JWT_PUBLIC_KEY=<pem-encoded-rsa-public-key>

# Shared key for service-to-service calls (X-Service-Key)
SERVICE_KEY=<generate-a-long-random-string>

# true: workspace-scoped routes accept only workspace tokens.
SCOPE_REQUIRE_WORKSPACE_TOKEN=false

# Redis (permission / workspace-role cache)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
